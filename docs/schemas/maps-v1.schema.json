{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:200-crappy-words:schema:maps:1",
  "title": "200 Crappy Words portable maps version 1",
  "description": "Project-owned static raster maps and note-linked points or polygons. The tested parser remains authoritative for global identity, aggregate limits, path portability, geometry, and unknown-field preservation.",
  "type": "object",
  "required": ["format", "formatVersion", "projectId", "maps"],
  "properties": {
    "format": { "const": "200-crappy-words/maps" },
    "formatVersion": { "const": 1 },
    "projectId": { "$ref": "#/$defs/uuidV4" },
    "maps": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/map" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "uuidV4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "positiveDimension": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "coordinate": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "required": ["path", "mediaType", "sha256", "width", "height"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\).+$"
        },
        "mediaType": { "enum": ["image/png", "image/jpeg", "image/webp"] },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "width": { "$ref": "#/$defs/positiveDimension" },
        "height": { "$ref": "#/$defs/positiveDimension" }
      },
      "additionalProperties": true
    },
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "$ref": "#/$defs/positiveDimension" },
        "height": { "$ref": "#/$defs/positiveDimension" }
      },
      "additionalProperties": true
    },
    "point": {
      "type": "object",
      "required": ["kind", "x", "y"],
      "properties": {
        "kind": { "const": "point" },
        "x": { "$ref": "#/$defs/coordinate" },
        "y": { "$ref": "#/$defs/coordinate" }
      },
      "additionalProperties": true
    },
    "vertex": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/coordinate" },
        { "$ref": "#/$defs/coordinate" }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "polygon": {
      "type": "object",
      "required": ["kind", "points"],
      "properties": {
        "kind": { "const": "polygon" },
        "points": {
          "type": "array",
          "minItems": 3,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/vertex" }
        }
      },
      "additionalProperties": true
    },
    "anchor": {
      "type": "object",
      "required": ["id", "noteId", "geometry"],
      "properties": {
        "id": { "$ref": "#/$defs/uuidV4" },
        "noteId": { "$ref": "#/$defs/uuidV4" },
        "geometry": {
          "oneOf": [
            { "$ref": "#/$defs/point" },
            { "$ref": "#/$defs/polygon" }
          ]
        }
      },
      "additionalProperties": true
    },
    "map": {
      "type": "object",
      "required": ["id", "title", "image", "canvas", "anchors"],
      "properties": {
        "id": { "$ref": "#/$defs/uuidV4" },
        "title": { "$ref": "#/$defs/title" },
        "image": { "$ref": "#/$defs/image" },
        "canvas": { "$ref": "#/$defs/canvas" },
        "anchors": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/anchor" }
        }
      },
      "additionalProperties": true
    }
  }
}
