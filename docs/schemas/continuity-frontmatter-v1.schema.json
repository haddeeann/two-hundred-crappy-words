{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:200-crappy-words:schema:continuity-frontmatter:1",
  "title": "200 Crappy Words structured-note frontmatter, continuity version 1",
  "description": "The data shape represented by the app's documented safe YAML subset. This schema does not relax the parser's source, indentation, duplicate-key, or quoted-string rules.",
  "type": "object",
  "properties": {
    "id": { "$ref": "#/$defs/uuidV4" },
    "type": { "$ref": "#/$defs/kebab" },
    "title": { "$ref": "#/$defs/shortText" },
    "aliases": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/shortText" }
    },
    "canon": { "$ref": "#/$defs/canon" },
    "facts": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/fact" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "uuidV4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "kebab": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "longText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "decimal": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "canon": {
      "type": "string",
      "enum": ["idea", "draft", "canon", "retired"]
    },
    "certainty": {
      "type": "string",
      "enum": ["exact", "approximate", "uncertain"]
    },
    "valueSource": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 80,
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      },
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string" }
      },
      "additionalProperties": true
    },
    "noteValue": {
      "allOf": [
        { "$ref": "#/$defs/valueSource" },
        {
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "note" },
            "id": { "$ref": "#/$defs/uuidV4" }
          }
        }
      ]
    },
    "textValue": {
      "allOf": [
        { "$ref": "#/$defs/valueSource" },
        {
          "required": ["kind", "text"],
          "properties": {
            "kind": { "const": "text" },
            "text": { "$ref": "#/$defs/longText" }
          }
        }
      ]
    },
    "quantityValue": {
      "allOf": [
        { "$ref": "#/$defs/valueSource" },
        {
          "required": ["kind", "amount", "unitSystem", "unit"],
          "properties": {
            "kind": { "const": "quantity" },
            "amount": { "$ref": "#/$defs/decimal" },
            "unitSystem": { "$ref": "#/$defs/kebab" },
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        }
      ]
    },
    "rangeValue": {
      "allOf": [
        { "$ref": "#/$defs/valueSource" },
        {
          "required": ["kind", "minimum", "maximum", "unitSystem", "unit"],
          "properties": {
            "kind": { "const": "range" },
            "minimum": { "$ref": "#/$defs/decimal" },
            "maximum": { "$ref": "#/$defs/decimal" },
            "unitSystem": { "$ref": "#/$defs/kebab" },
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        }
      ]
    },
    "timeValue": {
      "allOf": [
        { "$ref": "#/$defs/valueSource" },
        {
          "required": ["kind", "calendar", "expression"],
          "properties": {
            "kind": { "const": "time" },
            "calendar": { "$ref": "#/$defs/kebab" },
            "expression": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "calendar": { "const": "gregorian" } },
                "required": ["calendar"]
              },
              "then": {
                "properties": {
                  "expression": {
                    "pattern": "^[0-9]{4,}(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12][0-9]|3[01]))?)?(?:/[0-9]{4,}(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12][0-9]|3[01]))?)?)?$"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "unknownValue": {
      "allOf": [
        { "$ref": "#/$defs/valueSource" },
        {
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "unknown" },
            "reason": { "$ref": "#/$defs/longText" }
          }
        }
      ]
    },
    "value": {
      "oneOf": [
        { "$ref": "#/$defs/noteValue" },
        { "$ref": "#/$defs/textValue" },
        { "$ref": "#/$defs/quantityValue" },
        { "$ref": "#/$defs/rangeValue" },
        { "$ref": "#/$defs/timeValue" },
        { "$ref": "#/$defs/unknownValue" }
      ]
    },
    "fact": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 80,
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      },
      "required": ["id", "property", "value"],
      "properties": {
        "id": { "$ref": "#/$defs/uuidV4" },
        "property": { "$ref": "#/$defs/kebab" },
        "value": { "$ref": "#/$defs/value" },
        "canon": { "$ref": "#/$defs/canon" },
        "certainty": { "$ref": "#/$defs/certainty" },
        "validFrom": { "$ref": "#/$defs/timeValue" },
        "validTo": { "$ref": "#/$defs/timeValue" },
        "note": { "$ref": "#/$defs/longText" }
      },
      "additionalProperties": true
    }
  }
}
