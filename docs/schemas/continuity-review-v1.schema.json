{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:200-crappy-words:schema:continuity-review:1",
  "title": "200 Crappy Words continuity-review exceptions version 1",
  "description": "Project-owned explanations for deterministic Review or Contradiction findings. The tested parser remains authoritative for aggregate limits, global identity, sorted evidence, exact tuple uniqueness, and unknown-field preservation.",
  "type": "object",
  "required": ["format", "formatVersion", "projectId", "exceptions"],
  "properties": {
    "format": { "const": "200-crappy-words/continuity-review" },
    "formatVersion": { "const": 1 },
    "projectId": { "$ref": "#/$defs/uuidV4" },
    "exceptions": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/exception" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "uuidV4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "ruleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "exception": {
      "type": "object",
      "required": ["id", "ruleId", "ruleVersion", "evidenceIds", "explanation"],
      "properties": {
        "id": { "$ref": "#/$defs/uuidV4" },
        "ruleId": { "$ref": "#/$defs/ruleId" },
        "ruleVersion": { "type": "integer", "minimum": 1 },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceId" }
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        }
      },
      "additionalProperties": true
    }
  }
}
